# Database Configuration (Default for XAMPP Apache + MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=library_management_system
DB_USERNAME=root
DB_PASSWORD=

# Session & Security
SESSION_LIFETIME=86400
SESSION_SECURE=false
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Application Settings
APP_ENV=development
APP_DEBUG=true
