# ============================================================
# IU Central Library Management System - Backend Environment
# Production Alwaysdata Hosting Configuration Template
# ============================================================

# Database Connection (Alwaysdata MySQL)
DB_CONNECTION=mysql
DB_HOST=mysql-iucentrallibrary.alwaysdata.net
DB_PORT=3306
DB_DATABASE=iucentrallibrary_librarydb
DB_USERNAME=iucentrallibrary
DB_PASSWORD=CHANGE_ME

# Application Environment (Set to 'production' for live hosting)
APP_ENV=production
APP_DEBUG=false
ALLOW_SQLITE_FALLBACK=false

# CORS Configuration
# Include your production Vercel frontend URL and local dev origins
CORS_ALLOWED_ORIGIN=https://iu-central-library.vercel.app,http://localhost:5173,http://localhost:4173

# Session & Security Settings
# When frontend (Vercel) and backend (Alwaysdata) run on different domains over HTTPS:
# SESSION_SECURE must be true and SESSION_SAMESITE must be None for cookies to transmit.
SESSION_LIFETIME=86400
SESSION_SECURE=true
SESSION_SAMESITE=None

# Setup Security Key (Protects remote web /api/seed and /api/install endpoints)
SETUP_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY
